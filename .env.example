BOT_TOKEN=your_telegram_bot_token_here

# Google Sheets
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
SPREADSHEET_ID=your_google_spreadsheet_id_here

# Sheet names (можно не менять — используются имена по умолчанию)
# SHEET_USERS=users
# SHEET_TEACHERS=teachers
# SHEET_STUDENTS=students
# SHEET_LESSONS=lessons
# SHEET_BILLING=billing
# SHEET_PAYMENTS=student_period_payments
# SHEET_BRANCHES=branches
# SHEET_GROUPS=groups
# SHEET_TEACHER_GROUPS=teacher_groups
# SHEET_STUDENT_GROUPS=student_groups
# SHEET_STUDENT_REQUESTS=student_requests
# SHEET_SUBSCRIPTION_OVERRIDES=subscription_overrides
# SHEET_FINANCE_ENTRIES=finance_entries
# SHEET_TEACHER_PERIOD_SUBMISSIONS=teacher_period_submissions

# Контроль оплат: долги считаются с этого периода (YYYY-MM); пусто — за всё время.
# Ставьте месяц, с которого оплаты реально фиксируются в системе.
# DEBTORS_SINCE_PERIOD=2026-07

# Секрет ссылок-приглашений в группу (t.me/bot?start=g_...).
# Пусто — используется BOT_TOKEN. Смена секрета отзывает все разосланные ссылки.
# GROUP_LINK_SECRET=любая-случайная-строка

# Бот в мессенджере MAX — кабинет родителя (счета, оплата). Токен выдаёт @MasterBot в MAX.
# Пусто — MAX не запускается, Telegram-бот работает как обычно.
# MAX_BOT_TOKEN=

# Кабинет спортсмена: ученики этих групп могут завести свой кабинет (/start → «Я спортсмен»)
# и вести дневник тренировок. Листы training_entries/athlete_tasks создаёт
# scripts/setup_diary_sheets.py.
# ATHLETE_GROUP_IDS=GRP-0001
# SHEET_TRAINING_ENTRIES=training_entries
# SHEET_ATHLETE_TASKS=athlete_tasks

# Педагоги с правом выставлять счета ученикам своих групп (через запятую или |).
# Кнопка «🧾 Счета моих групп» появится у них в меню. Пусто — счета только у админов.
# BILLING_TEACHER_IDS=TCH-0009

# Смена: группы, идущие внахлёст в один вечер; интервалы в минутах от начала смены.
# Зарплата за день = ставка группы × объединение интервалов проведённых групп (занятия самих
# групп в зарплату не идут). Нестандартные дни — лист salary_day_overrides (кнопка у админа).
# SHIFT_GROUPS=GRP-0021:0-60,GRP-0022:0-120,GRP-0023:60-180
# SHIFT_LABEL=Смена Боброво

# Наличные: показывать родителю способ «💵 Наличные» (по умолчанию включено).
# Родитель жмёт «Уведомить об оплате» — админ подтверждает кнопкой.
# PAYMENT_CASH_ENABLED=true

# Email родителя для фискальных чеков: кнопка «✉️ Email для чеков» в меню и шаг при
# регистрации по ссылке группы. false — родителю про чеки не упоминается (по умолчанию true).
# PARENT_RECEIPT_EMAIL=true

# Педагоги, чьи индивидуальные занятия родители оплачивают напрямую педагогу:
# в счета/долги/прибыль не попадают, зарплата школы = 0 (группы — как обычно).
# DIRECT_PAY_TEACHER_IDS=TCH-0002

# Руководитель школы, который сам ведёт занятия: в «Прибыли» его зарплата
# не вычитается, а остаётся в прибыли (отдельная строка «👑 руководитель»).
# OWNER_TEACHER_IDS=TCH-0001

# Аренда зала: педагог с прямой оплатой перечисляет школе фикс. сумму с каждого
# своего индивидуального занятия (любой длительности) — выручка в «Прибыли».
# HALL_RENT_PER_LESSON=TCH-0002:500
# Учитывать аренду только с этого месяца (YYYY-MM); пусто — за всё время.
# HALL_RENT_SINCE_PERIOD=2026-08

# Группы, где зарплата педагога = процент от сбора за занятие (не ставка × время).
# Формат: GRP-XXXX:процент, через запятую. Пример — индивидуальные Яковлевой, 50%.
# REVENUE_SHARE_GROUPS=GRP-0020:50

# Зарплатная длительность групп (мин), если она отличается от фактической:
# пересекающиеся по времени группы. 0 = занятие отмечается, но в зарплату не идёт.
# SALARY_DURATION_GROUPS=GRP-0021:0,GRP-0022:90,GRP-0023:90

# ── Продакшен (Railway) ──────────────────────────────────────────────────────

# Webhook: задайте публичный URL сервиса (Railway → Settings → Domains)
# Если не задан — бот запускается в режиме polling (удобно для локальной разработки)
# WEBHOOK_URL=https://fokus-bot.railway.app

# PORT задаётся Railway автоматически. Менять только для локального тестирования вебхука.
# PORT=8080

# Redis: подключите Redis-плагин в Railway и вставьте REDIS_URL из его настроек.
# Если не задан — используется MemoryStorage (FSM-состояния сбрасываются при рестарте).
# REDIS_URL=redis://default:password@redis.railway.internal:6379

# Mini App: локальная разработка без Telegram — tg_id администратора для заголовка `Authorization: dev`.
# На проде НЕ задавать.
# MINIAPP_DEV_TG_ID=826576855
# Публичный HTTPS-адрес Mini App (страница /app/); задан → кнопка «Открыть кабинет» в меню админа.
# MINIAPP_URL=https://fokus.178-104-240-252.sslip.io/app/
